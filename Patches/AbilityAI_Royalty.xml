<?xml version="1.0" encoding="utf-8"?>
<!-- Ability AI rules for Royalty's combat psycasts (Source/AbilityAI/). Only applied when Royalty is active.
     Raider psycasters use them only with the "also use abilities no mod claims" setting on. A host mod that grants
     these psycasts and claims them shares the rules, because its ability copies share the vanilla def's extension list.
     Each rule sits in its own PatchOperationConditional on its def, so a psycast another mod removed or renamed
     costs only its own rule: a conditional with no nomatch succeeds when its xpath finds nothing, and the sequence
     goes on to the next one.
     Left out on purpose: Beckon, Flashstorm, Neuroquake, manhunter pulse, mass chaos
     skip, farskip, chunkskip, neural heat dump, throne speech and Word of love.
     Word of joy, inspiration and trust are zone work without a zone, as VPE's are (AbilityAIZones): Basic work for
     the player's colonists set to autocast them, never other factions.
     approachDistance (how far a ranged NPC, or a player pawn set to "Full Autocast", walks to get a target into
     range) is only on the enemy-targeted rules: their workers are the ones that can pick a target to walk toward.
     Chaos skip is left without one, since its target is an enemy already in melee.
     harmless marks the rules that disable without lasting harm: with the "allies in a mental break" setting on
     its default, those may also be used on a berserk ally.
     exclusive on an enemy-targeted rule keeps two casters of one faction off the same enemy: for effects that don't
     stack (a stun keeps the longer of two, a second burden or berserk does nothing). The other workers have it on by
     default. -->
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Royalty</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>

        <!-- Stun: first anyone aiming a grenade, launcher or psycast; otherwise the most dangerous enemy in range -->
        <li Class="PatchOperationConditional">
          <xpath>Defs/AbilityDef[defName="Stun"]</xpath>
          <match Class="PatchOperationAddModExtension">
            <xpath>Defs/AbilityDef[defName="Stun"]</xpath>
            <value>
              <li Class="AbilityAI.AbilityAIExtension">
                <workerClass>AbilityAI.AbilityAIWorker_Interrupt</workerClass>
                <priority>9</priority>
                <harmless>true</harmless>
              </li>
              <li Class="AbilityAI.AbilityAIExtension">
                <workerClass>AbilityAI.AbilityAIWorker_TargetHostile</workerClass>
                <priority>3</priority>
                <approachDistance>8</approachDistance>
                <harmless>true</harmless>
                <exclusive>true</exclusive>
              </li>
            </value>
          </match>
        </li>

        <li Class="PatchOperationConditional">
          <xpath>Defs/AbilityDef[defName="Burden"]</xpath>
          <match Class="PatchOperationAddModExtension">
            <xpath>Defs/AbilityDef[defName="Burden"]</xpath>
            <value>
              <li Class="AbilityAI.AbilityAIExtension">
                <workerClass>AbilityAI.AbilityAIWorker_TargetHostile</workerClass>
                <priority>2</priority>
                <approachDistance>8</approachDistance>
                <harmless>true</harmless>
                <exclusive>true</exclusive>
              </li>
            </value>
          </match>
        </li>

        <!-- An enemy with at least one of its own side within 6 tiles and none of the caster's -->
        <li Class="PatchOperationConditional">
          <xpath>Defs/AbilityDef[defName="Berserk"]</xpath>
          <match Class="PatchOperationAddModExtension">
            <xpath>Defs/AbilityDef[defName="Berserk"]</xpath>
            <value>
              <li Class="AbilityAI.AbilityAIExtension">
                <workerClass>AbilityAI.AbilityAIWorker_TargetHostile</workerClass>
                <priority>7</priority>
                <preferGrouped>true</preferGrouped>
                <minTargets>2</minTargets>
                <radius>6</radius>
                <avoidAllies>true</avoidAllies>
                <approachDistance>8</approachDistance>
                <exclusive>true</exclusive>
              </li>
            </value>
          </match>
        </li>

        <!-- Throw away an enemy that is in melee with the caster or an ally -->
        <li Class="PatchOperationConditional">
          <xpath>Defs/AbilityDef[defName="ChaosSkip"]</xpath>
          <match Class="PatchOperationAddModExtension">
            <xpath>Defs/AbilityDef[defName="ChaosSkip"]</xpath>
            <value>
              <li Class="AbilityAI.AbilityAIExtension">
                <workerClass>AbilityAI.AbilityAIWorker_TargetHostile</workerClass>
                <priority>4</priority>
                <meleeOnly>true</meleeOnly>
                <harmless>true</harmless>
              </li>
            </value>
          </match>
        </li>

        <!-- The pulses hit everyone in the area, so never with one of the caster's side inside. Two defs on one
             xpath: the conditional only needs one of them to exist, and the add then goes to whichever do. -->
        <li Class="PatchOperationConditional">
          <xpath>Defs/AbilityDef[defName="BlindingPulse" or defName="VertigoPulse"]</xpath>
          <match Class="PatchOperationAddModExtension">
            <xpath>Defs/AbilityDef[defName="BlindingPulse" or defName="VertigoPulse"]</xpath>
            <value>
              <li Class="AbilityAI.AbilityAIExtension">
                <workerClass>AbilityAI.AbilityAIWorker_AoEHostile</workerClass>
                <priority>5</priority>
                <minTargets>2</minTargets>
                <avoidAllies>true</avoidAllies>
                <approachDistance>8</approachDistance>
                <harmless>true</harmless>
              </li>
            </value>
          </match>
        </li>

        <li Class="PatchOperationConditional">
          <xpath>Defs/AbilityDef[defName="BerserkPulse"]</xpath>
          <match Class="PatchOperationAddModExtension">
            <xpath>Defs/AbilityDef[defName="BerserkPulse"]</xpath>
            <value>
              <li Class="AbilityAI.AbilityAIExtension">
                <workerClass>AbilityAI.AbilityAIWorker_AoEHostile</workerClass>
                <priority>8</priority>
                <minTargets>3</minTargets>
                <avoidAllies>true</avoidAllies>
                <approachDistance>8</approachDistance>
              </li>
            </value>
          </match>
        </li>

        <!-- The caster or an ally under half health near enemies, held in melee, or with two shooters on them -->
        <li Class="PatchOperationConditional">
          <xpath>Defs/AbilityDef[defName="Invisibility"]</xpath>
          <match Class="PatchOperationAddModExtension">
            <xpath>Defs/AbilityDef[defName="Invisibility"]</xpath>
            <value>
              <li Class="AbilityAI.AbilityAIExtension">
                <workerClass>AbilityAI.AbilityAIWorker_Defensive</workerClass>
                <priority>6</priority>
                <minThreats>2</minThreats>
              </li>
            </value>
          </match>
        </li>

        <!-- Gets an ally downed by pain alone back up; otherwise an ally in 40% pain or more -->
        <li Class="PatchOperationConditional">
          <xpath>Defs/AbilityDef[defName="Painblock"]</xpath>
          <match Class="PatchOperationAddModExtension">
            <xpath>Defs/AbilityDef[defName="Painblock"]</xpath>
            <value>
              <li Class="AbilityAI.AbilityAIExtension">
                <workerClass>AbilityAI.AbilityAIWorker_Rescue</workerClass>
                <priority>7</priority>
                <painShockOnly>true</painShockOnly>
              </li>
              <li Class="AbilityAI.AbilityAIExtension">
                <workerClass>AbilityAI.AbilityAIWorker_TargetFriendly</workerClass>
                <priority>3</priority>
                <minPain>0.4</minPain>
              </li>
            </value>
          </match>
        </li>

        <li Class="PatchOperationConditional">
          <xpath>Defs/AbilityDef[defName="Focus"]</xpath>
          <match Class="PatchOperationAddModExtension">
            <xpath>Defs/AbilityDef[defName="Focus"]</xpath>
            <value>
              <li Class="AbilityAI.AbilityAIExtension">
                <workerClass>AbilityAI.AbilityAIWorker_TargetFriendly</workerClass>
                <priority>2</priority>
              </li>
            </value>
          </match>
        </li>

        <li Class="PatchOperationConditional">
          <xpath>Defs/AbilityDef[defName="Waterskip"]</xpath>
          <match Class="PatchOperationAddModExtension">
            <xpath>Defs/AbilityDef[defName="Waterskip"]</xpath>
            <value>
              <li Class="AbilityAI.AbilityAIExtension">
                <workerClass>AbilityAI.AbilityAIWorker_Firefighting</workerClass>
                <priority>6</priority>
              </li>
            </value>
          </match>
        </li>

        <!-- A wall two tiles toward the nearest shooter, when two are on the caster and it has no cover yet -->
        <li Class="PatchOperationConditional">
          <xpath>Defs/AbilityDef[defName="Wallraise"]</xpath>
          <match Class="PatchOperationAddModExtension">
            <xpath>Defs/AbilityDef[defName="Wallraise"]</xpath>
            <value>
              <li Class="AbilityAI.AbilityAIExtension">
                <workerClass>AbilityAI.AbilityAIWorker_Cover</workerClass>
                <priority>4</priority>
                <offsetTowardThreat>2</offsetTowardThreat>
                <minThreats>2</minThreats>
              </li>
            </value>
          </match>
        </li>

        <li Class="PatchOperationConditional">
          <xpath>Defs/AbilityDef[defName="Smokepop"]</xpath>
          <match Class="PatchOperationAddModExtension">
            <xpath>Defs/AbilityDef[defName="Smokepop"]</xpath>
            <value>
              <li Class="AbilityAI.AbilityAIExtension">
                <workerClass>AbilityAI.AbilityAIWorker_Cover</workerClass>
                <priority>4</priority>
                <minThreats>2</minThreats>
              </li>
            </value>
          </match>
        </li>

        <!-- The skipshield also stops the caster's side shooting out, so only under heavier fire -->
        <li Class="PatchOperationConditional">
          <xpath>Defs/AbilityDef[defName="BulletShield"]</xpath>
          <match Class="PatchOperationAddModExtension">
            <xpath>Defs/AbilityDef[defName="BulletShield"]</xpath>
            <value>
              <li Class="AbilityAI.AbilityAIExtension">
                <workerClass>AbilityAI.AbilityAIWorker_Cover</workerClass>
                <priority>5</priority>
                <minThreats>3</minThreats>
              </li>
            </value>
          </match>
        </li>

        <!-- The target sleeps about 4 minutes afterwards, so not for a break with under a minute left (a berserk
             psycast lasts 15 s), and only for someone close: the caster has to walk up and touch them -->
        <li Class="PatchOperationConditional">
          <xpath>Defs/AbilityDef[defName="WordOfSerenity"]</xpath>
          <match Class="PatchOperationAddModExtension">
            <xpath>Defs/AbilityDef[defName="WordOfSerenity"]</xpath>
            <value>
              <li Class="AbilityAI.AbilityAIExtension">
                <workerClass>AbilityAI.AbilityAIWorker_Calm</workerClass>
                <priority>5</priority>
                <maxRange>8</maxRange>
                <minBreakSeconds>60</minBreakSeconds>
              </li>
            </value>
          </match>
        </li>

        <!-- Word of trust: the colony's prisoners set to recruit or reduce resistance, with resistance left -->
        <li Class="PatchOperationConditional">
          <xpath>Defs/AbilityDef[defName="WordOfTrust"]</xpath>
          <match Class="PatchOperationAddModExtension">
            <xpath>Defs/AbilityDef[defName="WordOfTrust"]</xpath>
            <value>
              <li Class="AbilityAI.AbilityAIExtension">
                <workerClass>AbilityAI.AbilityAIWorker_Zone</workerClass>
                <zoneTarget>Prisoners</zoneTarget>
              </li>
            </value>
          </match>
        </li>

        <!-- Word of joy: colonists awake whose mood is heading below the setting, without joyfuzz already -->
        <li Class="PatchOperationConditional">
          <xpath>Defs/AbilityDef[defName="WordOfJoy"]</xpath>
          <match Class="PatchOperationAddModExtension">
            <xpath>Defs/AbilityDef[defName="WordOfJoy"]</xpath>
            <value>
              <li Class="AbilityAI.AbilityAIExtension">
                <workerClass>AbilityAI.AbilityAIWorker_Zone</workerClass>
                <zoneTarget>LowMood</zoneTarget>
                <hediff>Joyfuzz</hediff>
              </li>
            </value>
          </match>
        </li>

        <!-- Word of inspiration: colonists awake, not inspired and able to be -->
        <li Class="PatchOperationConditional">
          <xpath>Defs/AbilityDef[defName="WordOfInspiration"]</xpath>
          <match Class="PatchOperationAddModExtension">
            <xpath>Defs/AbilityDef[defName="WordOfInspiration"]</xpath>
            <value>
              <li Class="AbilityAI.AbilityAIExtension">
                <workerClass>AbilityAI.AbilityAIWorker_Zone</workerClass>
                <zoneTarget>Inspirable</zoneTarget>
              </li>
            </value>
          </match>
        </li>

        <!-- Skip: one rule per use, each behind its own setting. Rescue first (a downed ally next to an enemy is
             about to die or be carried off), then sending an enemy away from someone who can't fight it off (which
             keeps the caster in place), then the caster's own escape. Skipping only stuns for a moment, so repel is
             harmless: with the default setting it may move a berserk pawn of the caster's own faction off a downed
             friend. -->
        <li Class="PatchOperationConditional">
          <xpath>Defs/AbilityDef[defName="Skip"]</xpath>
          <match Class="PatchOperationAddModExtension">
            <xpath>Defs/AbilityDef[defName="Skip"]</xpath>
            <value>
              <li Class="AbilityAI.AbilityAIExtension">
                <workerClass>AbilityAI.AbilityAIWorker_Skip</workerClass>
                <skipMode>Rescue</skipMode>
                <priority>7</priority>
                <healthThreshold>0.4</healthThreshold>
              </li>
              <li Class="AbilityAI.AbilityAIExtension">
                <workerClass>AbilityAI.AbilityAIWorker_Skip</workerClass>
                <skipMode>Repel</skipMode>
                <priority>6</priority>
                <healthThreshold>0.5</healthThreshold>
                <harmless>true</harmless>
              </li>
              <li Class="AbilityAI.AbilityAIExtension">
                <workerClass>AbilityAI.AbilityAIWorker_Skip</workerClass>
                <skipMode>Escape</skipMode>
                <priority>5</priority>
                <healthThreshold>0.35</healthThreshold>
              </li>
            </value>
          </match>
        </li>

        <!-- Solar pinhole: kept up by the player's colonists (Recast: Basic work, never NPCs). A new pinhole wipes
             the old one on its cell, so it is recast in place. -->
        <li Class="PatchOperationConditional">
          <xpath>Defs/AbilityDef[defName="SolarPinhole"]</xpath>
          <match Class="PatchOperationAddModExtension">
            <xpath>Defs/AbilityDef[defName="SolarPinhole"]</xpath>
            <value>
              <li Class="AbilityAI.AbilityAIExtension">
                <workerClass>AbilityAI.AbilityAIWorker_Recast</workerClass>
                <recastThing>SolarPinhole</recastThing>
              </li>
            </value>
          </match>
        </li>

        <!-- The pinhole itself selectable, so it shows its recast toggle (vanilla's can't be clicked at all).
             Shared with VPE's Solar Pinhole, which leaves the same thing. -->
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="SolarPinhole"]/selectable</xpath>
          <match Class="PatchOperationReplace">
            <xpath>Defs/ThingDef[defName="SolarPinhole"]/selectable</xpath>
            <value>
              <selectable>true</selectable>
            </value>
          </match>
          <nomatch Class="PatchOperationConditional">
            <xpath>Defs/ThingDef[defName="SolarPinhole"]</xpath>
            <match Class="PatchOperationAdd">
              <xpath>Defs/ThingDef[defName="SolarPinhole"]</xpath>
              <value>
                <selectable>true</selectable>
              </value>
            </match>
          </nomatch>
        </li>

      </operations>
    </match>
  </Operation>
</Patch>
