<?xml version="1.0" encoding="UTF-8"?>
<ModMetaData>
  <name>Ability AI</name>
  <packageId>saintwacko.AbilityAI</packageId>
  <author>saintwacko</author>
  <description>Lets raiders, visitors, animals and mechanoids decide when and where to use their abilities, and lets you set your own pawns' abilities to autocast from a right-click on the ability button.</description>
  <supportedVersions>
    <li>1.6</li>
    <li>1.7</li>
  </supportedVersions>
  <modVersion>1.1.2</modVersion>
  <modDependencies>
    <li>
      <packageId>brrainz.harmony</packageId>
      <displayName>Harmony</displayName>
      <steamWorkshopUrl>steam://url/CommunityFilePage/2009463077</steamWorkshopUrl>
      <downloadUrl>https://github.com/pardeike/HarmonyRimWorld/releases/latest</downloadUrl>
    </li>
  </modDependencies>
  <loadAfter>
    <li>brrainz.harmony</li>
    <!-- Optional: only when present. The VEF compat assembly (1.6/VEF, 1.7/VEF) references VEF's types, so VEF's
         assembly has to be loaded first. -->
    <li>OskarPotocki.VanillaFactionsExpanded.Core</li>
    <!-- Optional, likewise: the VPE compat assembly (1.6/VPE, 1.7/VPE) references VPE's types -->
    <li>VanillaExpanded.VPsycastsE</li>
    <!-- Optional, likewise: these add their grenade belts from their own patches, which run in load order, so our
         gear rules (Patches/AbilityAI_ApparelModded.xml) only find the belts when they load first -->
    <li>VanillaExpanded.VWEG</li>
    <li>mosi.FirefoamThings</li>
  </loadAfter>
  <!-- Hosts load after this mod (their own loadAfter), so their compat patches see our types. Nothing here names
       them: the hosts are optional to us and we are optional to them. -->
</ModMetaData>
