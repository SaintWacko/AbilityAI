<?xml version="1.0" encoding="utf-8"?>
<!-- Ability AI rules for other mods' worn gear with a verb (ApparelAIAbility), one block per mod, each behind
     PatchOperationFindMod on the mod's name and a conditional per def. Survey and per-item decisions:
     .circinus/handoff/apparel-verbs.md. Generated by .circinus/scratch/gen_modded_gear.py. -->
<Patch>

  <!-- Grenade belts. The radius is the blast plus the throw's 1.9 miss, as the grenadier armour's. The smoke, flash, tear gas,
       tox and dynamite belts exist only with the mod each needs (VWE, VWE Non-Lethal, Biotech, VFE Settlers); the
       conditionals skip the missing ones. -->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Vanilla Weapons Expanded - Grenades</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <!-- Frag: bomb 1.9 -->
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="VWE_Apparel_GrenadeFragBelt"]</xpath>
          <match Class="PatchOperationAddModExtension">
            <xpath>Defs/ThingDef[defName="VWE_Apparel_GrenadeFragBelt"]</xpath>
            <value>
              <li Class="AbilityAI.AbilityAIExtension">
                <workerClass>AbilityAI.AbilityAIWorker_AoEHostile</workerClass>
                <priority>3</priority>
                <radius>3.5</radius>
                <minTargets>2</minTargets>
                <avoidAllies>true</avoidAllies>
                <avoidBuildings>true</avoidBuildings>
              </li>
            </value>
          </match>
        </li>

        <!-- Molotov: fire 1.1 and burning fuel -->
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="VWE_Apparel_GrenadeMolotovBelt"]</xpath>
          <match Class="PatchOperationAddModExtension">
            <xpath>Defs/ThingDef[defName="VWE_Apparel_GrenadeMolotovBelt"]</xpath>
            <value>
              <li Class="AbilityAI.AbilityAIExtension">
                <workerClass>AbilityAI.AbilityAIWorker_AoEHostile</workerClass>
                <priority>3</priority>
                <radius>3</radius>
                <minTargets>2</minTargets>
                <avoidAllies>true</avoidAllies>
                <avoidBuildings>true</avoidBuildings>
                <startsFires>true</startsFires>
              </li>
            </value>
          </match>
        </li>

        <!-- EMP 3.5: mechs, turrets and raised shields only, and it spares the same of ours -->
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="VWE_Apparel_GrenadeEMPBelt"]</xpath>
          <match Class="PatchOperationAddModExtension">
            <xpath>Defs/ThingDef[defName="VWE_Apparel_GrenadeEMPBelt"]</xpath>
            <value>
              <li Class="AbilityAI.AbilityAIExtension">
                <workerClass>AbilityAI.AbilityAIWorker_AoEHostile</workerClass>
                <priority>3</priority>
                <radius>5.4</radius>
                <minTargets>1</minTargets>
                <targetKinds>Mechanoid, Turret, Shielded</targetKinds>
                <allyKinds>Mechanoid, Turret, Shielded</allyKinds>
                <avoidAllies>true</avoidAllies>
                <harmless>true</harmless>
              </li>
            </value>
          </match>
        </li>

        <!-- Smoke 5.2: cover once two shooters are on the thrower -->
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="VWE_Apparel_GrenadeSmokeBelt"]</xpath>
          <match Class="PatchOperationAddModExtension">
            <xpath>Defs/ThingDef[defName="VWE_Apparel_GrenadeSmokeBelt"]</xpath>
            <value>
              <li Class="AbilityAI.AbilityAIExtension">
                <workerClass>AbilityAI.AbilityAIWorker_Cover</workerClass>
                <priority>4</priority>
                <minThreats>2</minThreats>
              </li>
            </value>
          </match>
        </li>

        <!-- Flash: stun 1.99 -->
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="VWE_Apparel_GrenadeFlashBelt"]</xpath>
          <match Class="PatchOperationAddModExtension">
            <xpath>Defs/ThingDef[defName="VWE_Apparel_GrenadeFlashBelt"]</xpath>
            <value>
              <li Class="AbilityAI.AbilityAIExtension">
                <workerClass>AbilityAI.AbilityAIWorker_AoEHostile</workerClass>
                <priority>4</priority>
                <radius>3.9</radius>
                <minTargets>2</minTargets>
                <avoidAllies>true</avoidAllies>
                <harmless>true</harmless>
              </li>
            </value>
          </match>
        </li>

        <!-- Tear gas 3.9 -->
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="VWE_Apparel_GrenadeTearGasBelt"]</xpath>
          <match Class="PatchOperationAddModExtension">
            <xpath>Defs/ThingDef[defName="VWE_Apparel_GrenadeTearGasBelt"]</xpath>
            <value>
              <li Class="AbilityAI.AbilityAIExtension">
                <workerClass>AbilityAI.AbilityAIWorker_AoEHostile</workerClass>
                <priority>3</priority>
                <radius>5.8</radius>
                <minTargets>2</minTargets>
                <targetKinds>Humanlike, Animal</targetKinds>
                <avoidAllies>true</avoidAllies>
                <harmless>true</harmless>
              </li>
            </value>
          </match>
        </li>

        <!-- Tox gas 1.9, which spreads -->
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="VWE_Apparel_GrenadeToxicBelt"]</xpath>
          <match Class="PatchOperationAddModExtension">
            <xpath>Defs/ThingDef[defName="VWE_Apparel_GrenadeToxicBelt"]</xpath>
            <value>
              <li Class="AbilityAI.AbilityAIExtension">
                <workerClass>AbilityAI.AbilityAIWorker_AoEHostile</workerClass>
                <priority>3</priority>
                <radius>3.8</radius>
                <minTargets>2</minTargets>
                <targetKinds>Humanlike, Animal</targetKinds>
                <avoidAllies>true</avoidAllies>
              </li>
            </value>
          </match>
        </li>

        <!-- Dynamite: bomb 3.5 on a random fuse, so never near the thrower either -->
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="VWE_Apparel_DynamiteBelt"]</xpath>
          <match Class="PatchOperationAddModExtension">
            <xpath>Defs/ThingDef[defName="VWE_Apparel_DynamiteBelt"]</xpath>
            <value>
              <li Class="AbilityAI.AbilityAIExtension">
                <workerClass>AbilityAI.AbilityAIWorker_AoEHostile</workerClass>
                <priority>3</priority>
                <radius>5.4</radius>
                <minTargets>2</minTargets>
                <avoidAllies>true</avoidAllies>
                <avoidBuildings>true</avoidBuildings>
                <avoidSelf>true</avoidSelf>
              </li>
            </value>
          </match>
        </li>
      </operations>
    </match>
  </Operation>

  <!-- Firefoam grenade belt: foam 3.5 where it lands, for a fire worth it (as the firefoam pack) -->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Firefoam Things</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="Mosi_Apparel_GrenadeFirefoamBelt"]</xpath>
          <match Class="PatchOperationAddModExtension">
            <xpath>Defs/ThingDef[defName="Mosi_Apparel_GrenadeFirefoamBelt"]</xpath>
            <value>
              <li Class="AbilityAI.AbilityAIExtension">
                <workerClass>AbilityAI.AbilityAIWorker_Firefighting</workerClass>
                <priority>6</priority>
                <minTargets>3</minTargets>
              </li>
            </value>
          </match>
        </li>
      </operations>
    </match>
  </Operation>

  <!-- Smoke bomb (single use): smoke around the wearer, as the smokepop belt -->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>T&apos;s Samurai Faction</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="TSFApparel_SmokeBomb"]</xpath>
          <match Class="PatchOperationAddModExtension">
            <xpath>Defs/ThingDef[defName="TSFApparel_SmokeBomb"]</xpath>
            <value>
              <li Class="AbilityAI.AbilityAIExtension">
                <workerClass>AbilityAI.AbilityAIWorker_Cover</workerClass>
                <priority>4</priority>
                <minThreats>2</minThreats>
              </li>
            </value>
          </match>
        </li>
      </operations>
    </match>
  </Operation>

  <!-- Pot belts. Radius: the blast plus the 1.9 miss. -->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Medieval Overhaul</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <!-- Flash pot: dazes everyone within 2.5 -->
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="DankPyon_Apparel_FlashPotBelt"]</xpath>
          <match Class="PatchOperationAddModExtension">
            <xpath>Defs/ThingDef[defName="DankPyon_Apparel_FlashPotBelt"]</xpath>
            <value>
              <li Class="AbilityAI.AbilityAIExtension">
                <workerClass>AbilityAI.AbilityAIWorker_AoEHostile</workerClass>
                <priority>4</priority>
                <radius>4.4</radius>
                <minTargets>2</minTargets>
                <hediff>DankPyon_Daze</hediff>
                <avoidAllies>true</avoidAllies>
                <harmless>true</harmless>
              </li>
            </value>
          </match>
        </li>

        <!-- Fire pot: fire 1.1 and tar -->
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="DankPyon_Apparel_FirePotBelt"]</xpath>
          <match Class="PatchOperationAddModExtension">
            <xpath>Defs/ThingDef[defName="DankPyon_Apparel_FirePotBelt"]</xpath>
            <value>
              <li Class="AbilityAI.AbilityAIExtension">
                <workerClass>AbilityAI.AbilityAIWorker_AoEHostile</workerClass>
                <priority>3</priority>
                <radius>3</radius>
                <minTargets>2</minTargets>
                <avoidAllies>true</avoidAllies>
                <avoidBuildings>true</avoidBuildings>
                <startsFires>true</startsFires>
              </li>
            </value>
          </match>
        </li>

        <!-- Smoke pot 3.5 -->
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="DankPyon_Apparel_SmokePotBelt"]</xpath>
          <match Class="PatchOperationAddModExtension">
            <xpath>Defs/ThingDef[defName="DankPyon_Apparel_SmokePotBelt"]</xpath>
            <value>
              <li Class="AbilityAI.AbilityAIExtension">
                <workerClass>AbilityAI.AbilityAIWorker_Cover</workerClass>
                <priority>4</priority>
                <minThreats>2</minThreats>
              </li>
            </value>
          </match>
        </li>

        <!-- Acid flask 1.5 -->
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="DankPyon_Apparel_AcidFlaskBelt"]</xpath>
          <match Class="PatchOperationAddModExtension">
            <xpath>Defs/ThingDef[defName="DankPyon_Apparel_AcidFlaskBelt"]</xpath>
            <value>
              <li Class="AbilityAI.AbilityAIExtension">
                <workerClass>AbilityAI.AbilityAIWorker_AoEHostile</workerClass>
                <priority>3</priority>
                <radius>3.4</radius>
                <minTargets>2</minTargets>
                <avoidAllies>true</avoidAllies>
                <avoidBuildings>true</avoidBuildings>
              </li>
            </value>
          </match>
        </li>
      </operations>
    </match>
  </Operation>

  <!-- Torch belt: a thrown torch (fire 0.9) sets one enemy alight; nobody of ours or our buildings near it -->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Vanilla Factions Expanded - Medieval 2</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="VFEM2_Apparel_TorchBelt"]</xpath>
          <match Class="PatchOperationAddModExtension">
            <xpath>Defs/ThingDef[defName="VFEM2_Apparel_TorchBelt"]</xpath>
            <value>
              <li Class="AbilityAI.AbilityAIExtension">
                <workerClass>AbilityAI.AbilityAIWorker_TargetHostile</workerClass>
                <priority>3</priority>
                <radius>2.8</radius>
                <avoidAllies>true</avoidAllies>
                <avoidBuildings>true</avoidBuildings>
                <startsFires>true</startsFires>
              </li>
            </value>
          </match>
        </li>
      </operations>
    </match>
  </Operation>

  <!-- Warcasket parts are VFEPirates.WarcasketDef elements, not ThingDef ones. -->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Vanilla Factions Expanded - Pirates</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <!-- Barrage shoulders: four frags (1.9) per cast, each with the 1.9 miss -->
        <li Class="PatchOperationConditional">
          <xpath>Defs/VFEPirates.WarcasketDef[defName="VFEP_WarcasketShoulders_Barrage"]</xpath>
          <match Class="PatchOperationAddModExtension">
            <xpath>Defs/VFEPirates.WarcasketDef[defName="VFEP_WarcasketShoulders_Barrage"]</xpath>
            <value>
              <li Class="AbilityAI.AbilityAIExtension">
                <workerClass>AbilityAI.AbilityAIWorker_AoEHostile</workerClass>
                <priority>3</priority>
                <radius>3.5</radius>
                <minTargets>2</minTargets>
                <avoidAllies>true</avoidAllies>
                <avoidBuildings>true</avoidBuildings>
              </li>
            </value>
          </match>
        </li>

        <!-- Controller warcasket: three or four wardrones (miniturret) at the wearer's feet; one charge -->
        <li Class="PatchOperationConditional">
          <xpath>Defs/VFEPirates.WarcasketDef[defName="VFEP_Warcasket_Controller"]</xpath>
          <match Class="PatchOperationAddModExtension">
            <xpath>Defs/VFEPirates.WarcasketDef[defName="VFEP_Warcasket_Controller"]</xpath>
            <value>
              <li Class="AbilityAI.AbilityAIExtension">
                <workerClass>AbilityAI.AbilityAIWorker_Deploy</workerClass>
                <priority>4</priority>
                <minTargets>2</minTargets>
                <deployedThing>VFEP_Mech_Wardrone</deployedThing>
              </li>
            </value>
          </match>
        </li>

        <!-- Controller shoulders: the spidermine lands, walks to the best attack target near it and dies there in a 4.9 flame blast that starts fires (DeathActionWorker_SpidermineExplosion) -->
        <li Class="PatchOperationConditional">
          <xpath>Defs/VFEPirates.WarcasketDef[defName="VFEP_WarcasketShoulders_Controller"]</xpath>
          <match Class="PatchOperationAddModExtension">
            <xpath>Defs/VFEPirates.WarcasketDef[defName="VFEP_WarcasketShoulders_Controller"]</xpath>
            <value>
              <li Class="AbilityAI.AbilityAIExtension">
                <workerClass>AbilityAI.AbilityAIWorker_TargetHostile</workerClass>
                <priority>3</priority>
                <radius>4.9</radius>
                <preferGrouped>true</preferGrouped>
                <avoidAllies>true</avoidAllies>
                <avoidBuildings>true</avoidBuildings>
                <startsFires>true</startsFires>
              </li>
            </value>
          </match>
        </li>

        <!-- Power jump (aerial shoulders, range from the helmet): a 3-tile blast where it takes off and where it lands, so no ally near either end. Its fuel is checked by Ability AI (VefApparelAbilities), since VEF only greys the gizmo. Blast off (world map), Siege mode (a toggle) and the grappling hook (aimed at a wall) have no rule. -->
        <li Class="PatchOperationConditional">
          <xpath>Defs/VEF.Abilities.AbilityDef[defName="VFEP_PowerJump"]</xpath>
          <match Class="PatchOperationAddModExtension">
            <xpath>Defs/VEF.Abilities.AbilityDef[defName="VFEP_PowerJump"]</xpath>
            <value>
              <li Class="AbilityAI.AbilityAIExtension">
                <workerClass>AbilityAI.AbilityAIWorker_Movement</workerClass>
                <priority>4</priority>
                <radius>3</radius>
                <avoidAllies>true</avoidAllies>
                <avoidBuildings>true</avoidBuildings>
                <pathClearance>3</pathClearance>
              </li>
            </value>
          </match>
        </li>
      </operations>
    </match>
  </Operation>

  <!-- Mechamancer pack: a satellite mech at the wearer's feet, at most two alive per pack (checked in ApparelGearCompat) -->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Apex Mechanoids</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="APM_Apparel_MechamancerPack"]</xpath>
          <match Class="PatchOperationAddModExtension">
            <xpath>Defs/ThingDef[defName="APM_Apparel_MechamancerPack"]</xpath>
            <value>
              <li Class="AbilityAI.AbilityAIExtension">
                <workerClass>AbilityAI.AbilityAIWorker_Deploy</workerClass>
                <priority>4</priority>
                <minTargets>2</minTargets>
                <deployedThing>APM_Mech_Satellite</deployedThing>
              </li>
            </value>
          </match>
        </li>
      </operations>
    </match>
  </Operation>

  <!-- Precise orbital beam (three charges, then gone): a fixed column of fire 3.5 across for about 17 seconds, spreading fire around it. Needs the player's beam target while Anomalies Expected's setting asks for one (checked in ApparelGearCompat). -->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Anomalies Expected</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="AEOrbitalBeamTargeter"]</xpath>
          <match Class="PatchOperationAddModExtension">
            <xpath>Defs/ThingDef[defName="AEOrbitalBeamTargeter"]</xpath>
            <value>
              <li Class="AbilityAI.AbilityAIExtension">
                <workerClass>AbilityAI.AbilityAIWorker_AoEHostile</workerClass>
                <priority>2</priority>
                <radius>5</radius>
                <minTargets>3</minTargets>
                <avoidAllies>true</avoidAllies>
                <avoidBuildings>true</avoidBuildings>
                <avoidSelf>true</avoidSelf>
                <startsFires>true</startsFires>
                <npcGate>BaseWrecking</npcGate>
              </li>
            </value>
          </match>
        </li>
      </operations>
    </match>
  </Operation>

  <!-- Lich skull: three lightning strikes on and within 2 of an unroofed enemy. Costs goodwill like the lances, so enemies only. -->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Cybranian - Anomaly Lich</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="Apparel_LichSkull"]</xpath>
          <match Class="PatchOperationAddModExtension">
            <xpath>Defs/ThingDef[defName="Apparel_LichSkull"]</xpath>
            <value>
              <li Class="AbilityAI.AbilityAIExtension">
                <workerClass>AbilityAI.AbilityAIWorker_TargetHostile</workerClass>
                <priority>3</priority>
                <radius>3</radius>
                <avoidAllies>true</avoidAllies>
                <avoidBuildings>true</avoidBuildings>
                <startsFires>true</startsFires>
              </li>
            </value>
          </match>
        </li>
      </operations>
    </match>
  </Operation>

  <!-- Heat pearls (single use): fills the neural heat of every psycaster within 4.9 (plus the 1.9 miss), so only enemy psycasters count and no psycaster of ours may be near -->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Vanilla Psycasts Expanded</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="VPE_HeatPearls"]</xpath>
          <match Class="PatchOperationAddModExtension">
            <xpath>Defs/ThingDef[defName="VPE_HeatPearls"]</xpath>
            <value>
              <li Class="AbilityAI.AbilityAIExtension">
                <workerClass>AbilityAI.AbilityAIWorker_AoEHostile</workerClass>
                <priority>3</priority>
                <radius>6.8</radius>
                <minTargets>1</minTargets>
                <targetKinds>Psycaster</targetKinds>
                <allyKinds>Psycaster</allyKinds>
                <avoidAllies>true</avoidAllies>
                <harmless>true</harmless>
              </li>
            </value>
          </match>
        </li>
      </operations>
    </match>
  </Operation>

  <!-- Hunter trap packs: the drone hunts and blows up once an enemy is within 9 of it. Radius: its blast. The antigrain one (14.9) is aimed as an area so the wearer stays outside it. The pack is recharged by a job, not used up. More Hunter Drones also swaps Odyssey's own hunter pack's verb, which keeps its rule from AbilityAI_Apparel.xml. -->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>More Hunter Drones</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <!-- Tox 5.9 -->
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="Apparel_PackHunter_Toxic"]</xpath>
          <match Class="PatchOperationAddModExtension">
            <xpath>Defs/ThingDef[defName="Apparel_PackHunter_Toxic"]</xpath>
            <value>
              <li Class="AbilityAI.AbilityAIExtension">
                <workerClass>AbilityAI.AbilityAIWorker_TargetHostile</workerClass>
                <priority>3</priority>
                <radius>5.9</radius>
                <targetKinds>Humanlike, Animal</targetKinds>
                <preferGrouped>true</preferGrouped>
                <avoidAllies>true</avoidAllies>
              </li>
            </value>
          </match>
        </li>

        <!-- Fire 3.9 -->
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="Apparel_PackHunter_Incendiary"]</xpath>
          <match Class="PatchOperationAddModExtension">
            <xpath>Defs/ThingDef[defName="Apparel_PackHunter_Incendiary"]</xpath>
            <value>
              <li Class="AbilityAI.AbilityAIExtension">
                <workerClass>AbilityAI.AbilityAIWorker_TargetHostile</workerClass>
                <priority>3</priority>
                <radius>3.9</radius>
                <preferGrouped>true</preferGrouped>
                <avoidAllies>true</avoidAllies>
                <avoidBuildings>true</avoidBuildings>
                <startsFires>true</startsFires>
              </li>
            </value>
          </match>
        </li>

        <!-- EMP 10.9: mechs and raised shields -->
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="Apparel_PackHunter_EMP"]</xpath>
          <match Class="PatchOperationAddModExtension">
            <xpath>Defs/ThingDef[defName="Apparel_PackHunter_EMP"]</xpath>
            <value>
              <li Class="AbilityAI.AbilityAIExtension">
                <workerClass>AbilityAI.AbilityAIWorker_TargetHostile</workerClass>
                <priority>3</priority>
                <radius>10.9</radius>
                <targetKinds>Mechanoid, Shielded</targetKinds>
                <allyKinds>Mechanoid, Turret, Shielded</allyKinds>
                <preferGrouped>true</preferGrouped>
                <avoidAllies>true</avoidAllies>
                <harmless>true</harmless>
              </li>
            </value>
          </match>
        </li>

        <!-- Smoke 8.6 on the enemy: blinds its shooters, and ours shooting in -->
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="Apparel_PackHunter_Smoke"]</xpath>
          <match Class="PatchOperationAddModExtension">
            <xpath>Defs/ThingDef[defName="Apparel_PackHunter_Smoke"]</xpath>
            <value>
              <li Class="AbilityAI.AbilityAIExtension">
                <workerClass>AbilityAI.AbilityAIWorker_TargetHostile</workerClass>
                <priority>2</priority>
                <preferGrouped>true</preferGrouped>
                <harmless>true</harmless>
              </li>
            </value>
          </match>
        </li>

        <!-- Antigrain 14.9 -->
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="Apparel_PackHunter_AntigrainWarhead"]</xpath>
          <match Class="PatchOperationAddModExtension">
            <xpath>Defs/ThingDef[defName="Apparel_PackHunter_AntigrainWarhead"]</xpath>
            <value>
              <li Class="AbilityAI.AbilityAIExtension">
